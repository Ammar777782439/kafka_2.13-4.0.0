# ============================================================================
# config.env
# ============================================================================
# Configuration file for generate-kafka-certs.sh
#
# This file is parsed safely by the script. Only KEY=VALUE lines are accepted.
# Blank lines and lines starting with # are ignored.
# Malformed lines will cause the script to abort with a fatal error.
#
# Do NOT use quotes around values unless they are part of the value itself.
# Do NOT use spaces around the equals sign.
# ============================================================================

# ----------------------------------------------------------------------------
# Certificate Authority (CA)
# ----------------------------------------------------------------------------
# Absolute paths to your existing internal CA certificate and private key.
# The script will use these to sign all generated certificates.
# The CA key must NOT be password-protected (or remove the passphrase first).

CA_CERT=/etc/pki/ca.crt
CA_KEY=/etc/pki/ca.key

# ----------------------------------------------------------------------------
# Output Directory
# ----------------------------------------------------------------------------
# All generated files will be placed here.
# The directory will be created automatically if it does not exist.

OUTPUT_DIR=/opt/kafka/certs

# ----------------------------------------------------------------------------
# Cryptographic Settings
# ----------------------------------------------------------------------------
# RSA key size in bits. Supported values: 2048, 3072, 4096.
# Recommended: 3072 (balanced between security and performance).

RSA_BITS=3072

# Certificate validity period in days.

VALID_DAYS=365

# ----------------------------------------------------------------------------
# Passwords
# ----------------------------------------------------------------------------
# These passwords are used for keystore and truststore protection.
# Use strong, unique passwords. They will never be printed to stdout.
#
# KEYSTORE_PASSWORD   : Password for kafka.keystore.p12 and kafka.keystore.jks
# TRUSTSTORE_PASSWORD : Password for kafka.truststore.jks
# KEY_PASSWORD        : Password for the private key inside the keystore

KEYSTORE_PASSWORD=ChangeMeKSPass123!
TRUSTSTORE_PASSWORD=ChangeMeTSPass123!
KEY_PASSWORD=ChangeMeKeyPass123!

# ----------------------------------------------------------------------------
# Certificate Subject (Distinguished Name)
# ----------------------------------------------------------------------------
# These fields form the X.509 Subject of both server and client certificates.
# All fields except COUNTRY are optional — leave empty to omit.

COUNTRY=US
STATE=California
LOCALITY=San Francisco
ORGANIZATION=AcmeCorp
ORGANIZATIONAL_UNIT=Data Platform
EMAIL=platform@acmecorp.com

# ----------------------------------------------------------------------------
# Common Names (CN)
# ----------------------------------------------------------------------------
# SERVER_CN : The Common Name for the server/broker certificate.
# CLIENT_CN : The Common Name for the client certificate.

SERVER_CN=kafka-broker
CLIENT_CN=kafka-client

# ----------------------------------------------------------------------------
# Subject Alternative Names (SAN) — DNS
# ----------------------------------------------------------------------------
# At least one DNS entry is REQUIRED.
# The script auto-detects all SERVER_DNS_* variables (no hardcoded limit).
# List every DNS name that clients and brokers will use to connect.

SERVER_DNS_1=broker1.acmecorp.internal
SERVER_DNS_2=broker2.acmecorp.internal
SERVER_DNS_3=broker3.acmecorp.internal
SERVER_DNS_4=kafka.acmecorp.internal
SERVER_DNS_5=localhost

# ----------------------------------------------------------------------------
# Subject Alternative Names (SAN) — IP Addresses
# ----------------------------------------------------------------------------
# Optional. The script auto-detects all SERVER_IP_* variables.
# List every IP address that clients and brokers will use to connect.

SERVER_IP_1=10.0.1.10
SERVER_IP_2=10.0.1.11
SERVER_IP_3=10.0.1.12
SERVER_IP_4=127.0.0.1

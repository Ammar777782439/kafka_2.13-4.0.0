# ============================================================================
# config.env
# ============================================================================
# Configuration file for generate-kafka-certs.sh
# ============================================================================

# Certificate Authority (CA)
CA_CERT=/home/deepone/kafka_2.13-4.0.0/config/kraft/pki/ca.crt
CA_KEY=/home/deepone/kafka_2.13-4.0.0/config/kraft/pki/ca.key

# Output Directory
OUTPUT_DIR=/home/deepone/kafka_2.13-4.0.0/config/kraft/ssl/server

# Cryptographic Settings
RSA_BITS=3072
VALID_DAYS=3650

# Passwords
KEYSTORE_PASSWORD=kafkasslpass
TRUSTSTORE_PASSWORD=kafkasslpass
KEY_PASSWORD=kafkasslpass

# Certificate Subject (Distinguished Name)
COUNTRY=US
STATE=California
LOCALITY=San Francisco
ORGANIZATION=MyCompany
ORGANIZATIONAL_UNIT=Data Platform
EMAIL=admin@mycompany.com

# Common Names (CN)
SERVER_CN=kafka
CLIENT_CN=client

# Subject Alternative Names (SAN) — DNS
SERVER_DNS_1=localhost
SERVER_DNS_2=kafka

# Subject Alternative Names (SAN) — IP Addresses
SERVER_IP_1=192.168.168.25
SERVER_IP_2=127.0.0.1
